# ─────────────────────────────────────────────────────────────────────────────
# server/.env  — production / VPS template
# Copy this file to `/var/www/zerotoken/testapi/.env` on the VPS (mode 600).
# The deploy script never overwrites the remote .env unless you pass --env.
#
# Required vars are marked REQUIRED. Optional vars have safe defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core runtime ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB Atlas (REQUIRED) ────────────────────────────────────────────────
# Use a dedicated db user with the smallest role that still allows writes.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/zerotoken-prod?appName=Cluster0

# ── JWT (REQUIRED) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-96-char-hex
JWT_EXPIRE=7d

# ── CORS — comma-separated list of allowed browser origins ──────────────────
# Server reflects whichever incoming Origin matches one of these.
ALLOWED_ORIGIN=https://testweb.zerotoken.in,https://testapp.zerotoken.in,http://localhost:5173

# ── OTP preview pill (test envs only) ───────────────────────────────────────
#   true   — API echoes back _dev_otp; send-otp auto-provisions unknown phones
#            as patient users so the OTP Preview pill works end-to-end.
#   false  — production-grade behaviour: no OTP in the body, no auto-create,
#            generic enumeration-safe responses.
OTP_ENABLE=true

# ── WhatsApp / Wacto (optional) ─────────────────────────────────────────────
# Leave disabled if you don't want OTPs to fan out to real phones during
# testing. The server still generates and stores the OTP either way.
WHATSAPP_ENABLED=false
# WACTO_API_KEY=
# WACTO_FROM=

# ── Razorpay (REQUIRED for BookFlow payments) ───────────────────────────────
# Test keys live at https://dashboard.razorpay.com/app/keys (Test Mode).
# Without these, POST /api/payments/razorpay/order returns 500 and the
# Confirm step of BookFlow shows "Booking failed. Please try again."
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
